# Copy to .env for local work, or set these in the Vercel project settings. NEVER commit real values:
# every .env* file except this one is ignored by git, and `npm run check:security-static` fails if a key,
# token or password-bearing database URL shows up in any tracked file or in the git history.
#
# Two kinds of variable:
#   NEXT_PUBLIC_*  -> copied into the JavaScript sent to EVERY browser. Public values only.
#   everything else -> server-only. Never prefix a secret with NEXT_PUBLIC_.
# When the app starts, public-env-guard.ts refuses a NEXT_PUBLIC_ variable that holds a secret.

# --- Supabase --------------------------------------------------------------------------------------
# PUBLIC (safe to expose): the project URL and the anon / publishable key. NOT READ BY THE APP TODAY: the
# browser never talks to Supabase (all data goes through our own /api/v1 endpoints), and the anon role has no
# privilege on this schema (migration 20260921000100_lock_api_roles_and_reference_rls). They are here for a
# future browser feature and for hosts (like the Vercel-Supabase integration) that set them for you.
# The anon key must be the anon/publishable one. The service-role key here is refused at startup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. The service-role key bypasses every access rule and can read and write every stored file.
# The app uses it in one file (src/server/env.ts), for Storage only, never for database access, and never
# sends it to a browser. Buckets vehicle-photos, vehicle-documents, customer-documents and deal-documents
# must be PRIVATE (the migration creates them on Supabase; `npm run storage:check` verifies; the app refuses
# a bucket that has been made public).
SUPABASE_SERVICE_ROLE_KEY=
# Server-side name of the project URL (the same value as NEXT_PUBLIC_SUPABASE_URL): https://<project-ref>.supabase.co
SUPABASE_URL=

# --- Database ---------------------------------------------------------------------------------------
# Runtime connection: the least-privilege `cda_app` role, via the pooled connection string.
# Row-Level Security applies to this role.
DATABASE_URL="postgresql://cda_app:CHANGE_ME@localhost:5432/cda?schema=public"

# Migrations, seed and the platform/auth client: the database OWNER role, DIRECT (non-pooled) connection.
DIRECT_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/cda?schema=public"

# Optional: only if your provider does not allow Prisma to create its own shadow database.
# SHADOW_DATABASE_URL=""

# --- AI providers (SERVER-ONLY SECRETS) ---------------------------------------------------------------
# Never prefix these with NEXT_PUBLIC_ (Next.js would copy them into the JavaScript sent to every browser),
# never import them in frontend code, never commit real values. The frontend only calls our own
# /api/v1/ai/* endpoints. `npm run check:ai-secrets` scans the source and the built browser bundle for
# leaks; `npm run ai:check` makes one tiny real call per configured provider.
# A provider is offered only when its key is set (OpenAI and Gemini also need a model name).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Models: Claude defaults to claude-sonnet-5; OpenAI and Gemini have no default, so set one to enable them.
# AI_MODEL_ANTHROPIC="claude-sonnet-5"
# AI_MODEL_OPENAI=
# AI_MODEL_GOOGLE=
# Optional: send a provider through your own gateway or proxy (https only in production).
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=
# AI_DEFAULT_PROVIDER="anthropic"
# Optional: USD per million tokens, so usage shows a cost. Without a price a call is counted in tokens only.
# AI_PRICING_JSON='{"<model name>":{"inputPerMTok":3,"outputPerMTok":15}}'
# AI_REQUEST_TIMEOUT_MS=60000

# --- Authentication and email ---------------------------------------------------------------------------
# Public base URL used in emailed links (verify email, reset password, accept invitation). Required in production.
APP_URL="http://localhost:3000"

# Email transport: "resend" (production) or "log" (local dev: prints links to the server console).
# "log" is refused in production. Get a key at resend.com and verify your sending domain.
EMAIL_TRANSPORT="log"
EMAIL_FROM="CDA <no-reply@yourdomain.com>"
# SERVER-ONLY SECRET, needed when EMAIL_TRANSPORT="resend".
# RESEND_API_KEY=

# Cookies are Secure + __Host- prefixed by default in production. Set "false" ONLY for local http testing.
# COOKIE_SECURE="false"

# Reject passwords found in known breaches (Have I Been Pwned, k-anonymity: only a 5-char hash prefix
# is sent). On by default in production; "off" disables it.
# PASSWORD_BREACH_CHECK="off"

# --- Demo data (development and staging ONLY) -------------------------------------------------------------
# `npm run db:seed:demo` fills a database with a fictional dealership. It refuses to run without
# ALLOW_DEMO_SEED=1 and always refuses in production. Its users share one password: set it here, or leave it
# unset and one is generated and printed once. Never set either of these in a production environment.
# ALLOW_DEMO_SEED=1
# DEMO_USER_PASSWORD=
